{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "InMemory",
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "ShipNex",
    "Audience": "ShipNexApp",
    "ExpiryMinutes": 1440,
    "SecretKey": ""
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Email": {
    "Provider": "Resend",
    "FromAddress": "no-reply@shipnex.com",
    "FromName": "ShipNex Logistics",
