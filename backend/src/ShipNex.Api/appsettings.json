    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "ResendApiKey": "",
    "DevMode": true
  },
  "App": {
    "BaseUrl": "https://shipnex.com"
  },
  "Cors": {
    "AllowedOrigins": "https://shipnex.com;https://www.shipnex.com"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "AzureConnectionString": "",
    "ContainerName": "shipnex-documents",
    "SupabaseUrl": "",
    "SupabaseServiceKey": "",
    "SupabaseBucket": "shipment-documents"
  },
  "Realtime": {
    "SupabaseUrl": "",
    "SupabaseAnonKey": ""
  }
