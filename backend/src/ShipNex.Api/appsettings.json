{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "//": "Trusted reverse proxies for X-Forwarded-For/Proto. Empty = headers ignored (safe default). In Docker set Proxy__KnownNetworks to the compose network CIDR, e.g. 172.16.0.0/12",
    "KnownProxies": "",
    "KnownNetworks": ""
  },
  "Database": {
    "Provider": "InMemory",
    "ConnectionString": "",
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "ShipNex",
    "Audience": "ShipNexApp",
    "ExpiryMinutes": 1440,
    "SecretKey": ""
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Email": {
    "Provider": "Resend",
    "FromAddress": "no-reply@shipnexaro.com",
    "FromName": "ShipNexaro",
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "ResendApiKey": "",
    "DevMode": true
  },
  "App": {
    "BaseUrl": "https://shipnexaro.com"
  },
  "Cors": {
    "AllowedOrigins": "https://shipnexaro.com;https://www.shipnexaro.com"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalPath": "uploads",
    "AzureConnectionString": "",
    "ContainerName": "shipnex-documents",
    "SupabaseUrl": "",
    "SupabaseServiceKey": "",
    "SupabaseBucket": "shipment-documents"
  },
  "Realtime": {
    "SupabaseUrl": "",
    "SupabaseAnonKey": ""
  }
}
