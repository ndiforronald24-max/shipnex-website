<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NuGet feed configuration for the ShipNex backend.

    NOTE: an earlier revision declared a "local-offline" source pointing at
    backend/nupkgs together with a <packageSourceMapping> block that pinned every
    dependency to it. That folder was never committed, so restore failed with
    NU1301 ("The local source ... doesn't exist") on every project, and the
    package source mapping prevented nuget.org from ever being consulted as a
    fallback. Restore is now driven solely by nuget.org.

    If you genuinely need offline restores, re-add a local folder feed AND
    create the folder, and make sure the packageSourceMapping does not exclude
    nuget.org for any package you actually use.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
