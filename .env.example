# ShipNex Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=YourSecurePasswordHere123!

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=YourSuperSecretKeyForProduction2026!MakeItLongAndRandom

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Google Maps (frontend live map — key is public by design; restrict it by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY=

# Backend API base URL used by the frontend.
# LEAVE BLANK for the normal deployment. The app then requests a relative
# '/api', which nginx proxies to the backend on the same origin
# (see nginx.prod.conf) - no CORS round trip, and it works in `npm run dev`
# too via the Vite proxy. Setting this to http://localhost:5000/api (as it
# used to default to) ships a live bundle that calls the CUSTOMER's own
# machine. Only set it when the API is on a genuinely different host.
VITE_API_URL=

# Browser origins allowed to call the API. Required outside Development:
# the API refuses to start when this is empty. Semicolon-separated, no
# trailing slash. Irrelevant when the SPA is same-origin behind nginx.
CORS_ALLOWED_ORIGINS=https://shipnex.com;https://www.shipnex.com

# Supabase Storage (secure private document storage)
# This is the DEFAULT provider in docker-compose.prod.yml — production uploads
# go to a private bucket instead of the container's writable layer.
# Set FILE_STORAGE_PROVIDER=Local to fall back to the uploads volume; these
# three values are then ignored. If Provider=Supabase and either of the first
# two is blank, the API refuses to start.
# The service key is SERVER-ONLY — never expose it to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-keep-secret
SUPABASE_BUCKET=shipment-documents

# Supabase Realtime (optional live tracking updates)
# The frontend uses the PUBLIC anon/publishable key ONLY — never the service key.
# Leave these blank to disable realtime; tracking then keeps working via REST refresh.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to true only after adding Realtime Authorization RLS policies
# (see docs/supabase-realtime-setup.md). Default false = public broadcast channels.
VITE_SUPABASE_REALTIME_PRIVATE=false

# Backend Realtime publisher (server-side). Overrides appsettings "Realtime" section:
# Realtime__SupabaseUrl / Realtime__SupabaseAnonKey
REALTIME_SUPABASE_URL=https://your-project.supabase.co
REALTIME_SUPABASE_ANON_KEY=your-anon-public-key

# Domain (for HTTPS)
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com

# Email sender address shown to customers. Keep it aligned with the domain you
# actually control, or SPF/DKIM will fail and mail will land in spam.
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com

# Environment
NODE_ENV=production

# ---------- Reverse proxy trust ----------
# The API only honours X-Forwarded-For / X-Forwarded-Proto from networks listed
# here. The default is Docker's private bridge range, which is correct for the
# bundled nginx; change it if you run the API outside Docker, or list the exact
# proxy IP. Leaving it empty means forwarded headers are ignored entirely, which
# breaks the per-IP rate limiter behind a proxy (all users share one bucket).
PROXY_KNOWN_NETWORKS=172.16.0.0/12

# ---------- CI / release deploy (optional) ----------
# When set, deploy.sh pulls this image instead of rebuilding the backend on the
# server. CI passes a ghcr.io/<repo>:<sha> tag so the released artifact is exactly
# the one that passed the pipeline.
# SHIPNEX_IMAGE=ghcr.io/your-org/shipnex-website:latest

# ---------- GitHub Actions secrets (documentation) ----------
# The deploy job in .github/workflows/ci.yml reads these from the `production`
# environment. Without them the deploy job fails fast with a clear error rather
# than silently doing nothing (the previous placeholder deploy was a no-op).
#   DEPLOY_HOST      - SSH hostname of the production server
#   DEPLOY_USER      - SSH user (must be able to run docker compose)
#   DEPLOY_SSH_KEY   - private key contents, no header/footer text
#   DEPLOY_PATH      - absolute path of the checkout on the server
#   HEALTH_URL       - public base URL, e.g. https://shipnex.com (repo or env var)
